# 应用配置
APP_NAME="Ninja-RAG"
DEBUG=false

# 数据路径
DATA_DIR="data/raw/wiki"

# MySQL 配置（Docker 默认端口）
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_DATABASE="ninja_rag"

# Milvus 配置（Docker 默认端口）
MILVUS_HOST="localhost"
MILVUS_PORT=19530
MILVUS_COLLECTION="naruto_wiki"

# Neo4j 配置（Docker 默认端口）
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"

# 嵌入模型配置
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIM=1024
EMBEDDING_DEVICE="cuda"  # 可选: cuda, cuda:0, cuda:1, cpu（如果无 GPU 使用 cpu）
EMBEDDING_BATCH_SIZE=32  # GPU 可用时可增大到 64 或 128

# 千问 API 配置
DASHSCOPE_API_KEY="your-api-key-here"
QWEN_MODEL="qwen-max"
QWEN_TEMPERATURE=0.7

# RAG 配置
DEFAULT_TOP_K=5
CHUNK_MAX_LENGTH=512

# 混合检索配置
DENSE_WEIGHT=0.5          # 稠密向量权重（0-1）
SPARSE_WEIGHT=0.5         # 稀疏检索（BM25）权重（0-1）
USE_HYDE=false            # 是否启用 HyDE（会增加 LLM 调用）

# 知识图谱配置
ENABLE_KG=true
KG_WEIGHT=0.4
LLM_EXTRACT_ENTITIES=true

# 同步配置
AUTO_SYNC_ON_STARTUP=false
